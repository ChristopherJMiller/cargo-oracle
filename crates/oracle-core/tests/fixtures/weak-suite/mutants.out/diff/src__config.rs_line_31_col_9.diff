 pub fn parse(s: &str) -> Result<Config, String> {
     let (host, port) = s.split_once(':').ok_or("missing port")?;
     let port: u16 = port.parse().map_err(|_| "bad port".to_string())?;
     Ok(Config::new(host, port))
 }
